generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Car {
  id        String     @id @default(uuid()) @db.Uuid
  plate     String     @unique
  color     String
  brand     String
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  usages    CarUsage[]

  @@map("cars")
}

model Driver {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  usages    CarUsage[]

  @@map("drivers")
}

/// Registro de utilização de um automóvel por um motorista.
/// endedAt nulo significa que a utilização ainda está em andamento.
/// A migration cria índices únicos parciais (car_id / driver_id WHERE ended_at IS NULL)
/// para garantir no banco que carro e motorista tenham no máximo uma utilização ativa.
model CarUsage {
  id        String    @id @default(uuid()) @db.Uuid
  carId     String    @map("car_id") @db.Uuid
  driverId  String    @map("driver_id") @db.Uuid
  startedAt DateTime  @map("started_at")
  endedAt   DateTime? @map("ended_at")
  reason    String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  car    Car    @relation(fields: [carId], references: [id], onDelete: Restrict)
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Restrict)

  @@index([carId])
  @@index([driverId])
  @@map("car_usages")
}

enum Role {
  ADMIN
  USER
}

enum TwoFactorPurpose {
  PHONE_VERIFICATION
  LOGIN
}

/// Usuário do sistema. O telefone é verificado por SMS no cadastro (obrigatório antes do
/// primeiro login) e, se two_factor_enabled estiver ativo, todo login exige um código por SMS.
model User {
  id                     String            @id @default(uuid()) @db.Uuid
  name                   String
  email                  String            @unique
  passwordHash           String            @map("password_hash")
  role                   Role              @default(USER)
  phone                  String
  phoneVerifiedAt        DateTime?         @map("phone_verified_at")
  twoFactorEnabled       Boolean           @default(false) @map("two_factor_enabled")
  /// Hash SHA-256 do código enviado por SMS (nunca o código em texto puro)
  twoFactorCode          String?           @map("two_factor_code")
  twoFactorCodePurpose   TwoFactorPurpose? @map("two_factor_code_purpose")
  twoFactorCodeExpiresAt DateTime?         @map("two_factor_code_expires_at")
  twoFactorAttempts      Int               @default(0) @map("two_factor_attempts")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")
  refreshTokens          RefreshToken[]

  @@map("users")
}

/// Refresh tokens opacos (armazenados como hash). Rotacionados a cada uso.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}
