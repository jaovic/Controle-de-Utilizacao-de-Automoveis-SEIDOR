# Usado ao rodar a API fora do Docker (npm run dev).
# O docker-compose.yml já define suas próprias variáveis e não precisa deste arquivo.

PORT=3333
NODE_ENV=development

# Conexão usada pela aplicação.
# Local (banco do docker compose): localhost:5432
# Supabase: URL do pooler (porta 6543) com ?pgbouncer=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ttp?schema=public

# Conexão direta usada pelas migrations.
# Local: igual à DATABASE_URL. Supabase: URL direta (porta 5432)
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/ttp?schema=public

# Rate limit por IP: máximo de requisições dentro da janela (ms)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Proxies confiáveis à frente da API, para o rate limit enxergar o IP real.
# Local: 0. Render/Railway/Fly (atrás de 1 proxy): 1
TRUST_PROXY=0
