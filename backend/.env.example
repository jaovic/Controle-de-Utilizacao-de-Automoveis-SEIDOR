# Usado ao rodar a API fora do Docker (npm run dev).
# O docker-compose.yml da raiz já define suas próprias variáveis.

PORT=3333
NODE_ENV=development

# ---------- Banco ----------
# Local (banco do docker compose): localhost:5432
# Supabase: URL do pooler (porta 6543) com ?pgbouncer=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ttp?schema=public
# Conexão direta usada pelas migrations. Local: igual à DATABASE_URL. Supabase: porta 5432
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/ttp?schema=public

# ---------- Autenticação ----------
# Gere um valor aleatório em produção: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-de-48-bytes
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# true em produção (HTTPS); false em localhost (HTTP)
COOKIE_SECURE=false

# ---------- SMS (2FA) ----------
# console: o código aparece no log e no campo devCode das respostas (desenvolvimento)
# twilio: envia SMS de verdade (preencha as variáveis abaixo)
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Modo demonstração: se a Twilio recusar o envio por limitação da conta (ex.: trial com número
# não verificado), o código aparece na tela. Números verificados continuam recebendo SMS.
SMS_DEMO_FALLBACK=false

# ---------- Admin inicial (criado pelo seed) ----------
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@ttp.local
ADMIN_PASSWORD=Admin@123
ADMIN_PHONE=+5511999999999

# ---------- Rate limit ----------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
# Limite por IP nas rotas de login, cadastro e códigos SMS
AUTH_RATE_LIMIT_MAX=10
# Limite por usuário autenticado (identificado pelo token), somado ao limite por IP
USER_RATE_LIMIT_MAX=60
# Proxies confiáveis à frente da API. Local sem proxy: 0. Docker com o front: 1. Railway + Vercel: 2
TRUST_PROXY=0
